# Server Environment
PORT=5000
NODE_ENV=development

# Database & Cache
MONGO_URI=mongodb://admin:securepassword@localhost:27017/pulseguard?authSource=admin
REDIS_URI=redis://localhost:6379

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_random_32_character_secret_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Optional: Real SMTP Configuration (if omitted, automated Ethereal sandbox is used)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_smtp_key_here
